# ─────────────────────────────────────────────────────────────
#  MAYAN POOL — Variables de entorno
#  Copia este archivo como .env.local para desarrollo local y
#  configura los mismos valores en Vercel → Settings → Environment Variables.
#  Todas son públicas (NEXT_PUBLIC_) porque se muestran en el sitio.
# ─────────────────────────────────────────────────────────────

# URL canónica del sitio (sin diagonal final)
NEXT_PUBLIC_SITE_URL=https://mayanpool.com

# Origen de imágenes y video (bucket S3 o CDN), sin diagonal final.
# Vacío = se usan las copias locales de /public.
NEXT_PUBLIC_ASSETS_URL=https://mayanpool.s3.amazonaws.com

# WhatsApp: solo dígitos, con código de país. Ej. México: 52 + 10 dígitos
# PENDIENTE: proporcionar el número real
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo de contacto. PENDIENTE: proporcionar el correo real
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociales (URL completas). Si se dejan vacías, no se muestran.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Opcional: código de verificación de Google Search Console (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
